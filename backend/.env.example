# Profession Web App — конфигурация бэкенда
# Скопируйте файл в `.env` и заполните значения. Секреты в репозиторий не коммитятся.

# Django
SECRET_KEY=change-me                 # секретный ключ Django (обязательно сменить в проде)
DEBUG=True                           # режим отладки; в проде — False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000

# База данных (PostgreSQL)
DB_NAME=profession
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Статика и медиа
STATIC_URL=/static/
STATIC_ROOT=/app/static
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# Шифрование (например, e-mail пользователей хранятся в зашифрованном виде)
ENCRYPTION_KEY=00000000000000000000000000000000   # 32 байта; сменить в проде

# Почта (SMTP). По умолчанию письма выводятся в консоль (console.EmailBackend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com

# SMS (по умолчанию — вывод в консоль)
SMS_BACKEND=sms.backends.console.SmsBackend
DEFAULT_FROM_SMS=+70000000000
NOTIFICORE_API_KEY=
NOTIFICORE_API_URL=

# Фронтенд (для ссылок в письмах и редиректов)
FRONTEND_HOST=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Хранилище файлов (S3 / Yandex Object Storage)
# USE_S3=False — файлы хранятся на локальном диске (dev)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=ru-central1
ASSET_S3_EVENT_QUEUE_URL=             # очередь событий загрузки ассетов

# Redis (кэш, channels, результаты Celery)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=
REDIS_KEY_PREFIX=
CELERY_RESULT_BACKEND=redis://redis:6379/0

# RabbitMQ (брокер Celery, шина уведомлений)
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_NOTIFICATIONS_EXCHANGE=notifications.broadcast

# Agora (видеотрансляции вебинаров и интерактивная доска)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_WHITEBOARD_APP_ID=
AGORA_WHITEBOARD_AK=
AGORA_WHITEBOARD_SK=
AGORA_WHITEBOARD_REGION=eu

# Kinescope (хостинг записей вебинаров)
KINESCOPE_API_TOKEN=
KINESCOPE_PROJECT_ID=
KINESCOPE_DRM_AUTH_USERNAME=
KINESCOPE_DRM_AUTH_PASSWORD=

# Yandex GPT (ИИ-ассистент, Vector Store)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_ASSISTANT_ID=
YANDEX_MODEL=

# OAuth — Яндекс ID
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:9000/api/auth/yandex/callback/
FRONTEND_OAUTH_YANDEX_REDIRECT_URI=http://localhost:3000/oauth/yandex/callback

# OAuth — VK ID
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:9000/api/auth/vk/callback/
FRONTEND_OAUTH_VK_REDIRECT_URI=http://localhost:3000/oauth/vk/callback
