# Profession Web App — конфигурация фронтенда
# Скопируйте файл в `.env` и заполните значения.
# ВНИМАНИЕ: все переменные VITE_* попадают в клиентский бандл и видны в браузере.
# Сюда кладутся только публичные идентификаторы — никаких секретов.

# API
# Пусто → используется относительный путь /api (проксируется Vite/Nginx на бэкенд)
VITE_API_URL=

# OAuth — Яндекс ID
VITE_YANDEX_CLIENT_ID=
VITE_YANDEX_REDIRECT_URI=
VITE_YANDEX_RESPONSE_TYPE=code

# OAuth — VK ID
VITE_VK_CLIENT_ID=
VITE_VK_REDIRECT_URI=
VITE_VK_SCOPE=
